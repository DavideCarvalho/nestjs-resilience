{
  "name": "@dudousxd/nestjs-resilience-store-mikro-orm",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-resilience.git",
    "directory": "packages/store-mikro-orm"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/resilience",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-resilience/issues"
  },
  "keywords": [
    "nestjs",
    "resilience",
    "store",
    "mikro",
    "orm"
  ],
  "description": "MikroORM (Postgres) ResilienceStore for @dudousxd/nestjs-resilience",
  "license": "MIT",
  "author": "Davide Carvalho",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/*.db.spec.ts' --passWithNoTests",
    "test:db": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-resilience": ">=0.1.0 <1.0.0",
    "@mikro-orm/core": "^6.0.0 || ^7.0.0",
    "@mikro-orm/postgresql": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@dudousxd/nestjs-resilience": "workspace:^",
    "@mikro-orm/core": "^6.6.15",
    "@mikro-orm/postgresql": "^6.6.15",
    "@testcontainers/postgresql": "^10.18.0",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8",
    "typescript": "^7.0.0",
    "vitest": "^3.2.6"
  }
}
