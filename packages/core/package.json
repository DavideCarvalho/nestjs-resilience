{
  "name": "@dudousxd/nestjs-resilience",
  "version": "0.3.1",
  "description": "Resilience policies for NestJS — timeout, retry, circuit breaker, and ordered failover, with pluggable circuit state stores",
  "license": "MIT",
  "author": "Davide Carvalho",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-diagnostics": ">=0.2.0 <1",
    "@nestjs/common": "^10 || ^11 || ^12",
    "@nestjs/core": "^10 || ^11 || ^12"
  },
  "peerDependenciesMeta": {
    "@dudousxd/nestjs-diagnostics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dudousxd/nestjs-diagnostics": "^0.2.3",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^22.20.2",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "tsup": "^8",
    "typescript": "^5.6",
    "vitest": "^3.2.6"
  },
  "keywords": [
    "tanstack-intent"
  ]
}
