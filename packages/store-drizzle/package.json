{
  "name": "@dudousxd/nestjs-resilience-store-drizzle",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-resilience.git",
    "directory": "packages/store-drizzle"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/resilience",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-resilience/issues"
  },
  "keywords": [
    "nestjs",
    "resilience",
    "store",
    "drizzle"
  ],
  "description": "Drizzle (SQLite) ResilienceStore for @dudousxd/nestjs-resilience",
